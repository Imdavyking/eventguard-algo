    "@x402/fetch": "2.11.0",
    "@x402/hono": "2.11.0",
    "algosdk": "^3.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
