# --- Network: "mainnet" for the challenge, "testnet" for validation ---
NETWORK=testnet
FACILITATOR_URL=https://facilitator.goplausible.xyz
PORT=4021

# payTo: public address that receives USDC (must be opted in to USDC). Keep the SAME address all competition.
AVM_ADDRESS=

# Flight data (REQUIRED, live only; the server refuses to start without it. There is no demo mode.)
# Primary: AeroDataBox via API.market (default) or RapidAPI. Delay is computed from scheduled vs actual timestamps.
FLIGHT_PROVIDER=aerodatabox
AERODATABOX_API_KEY=
# AERODATABOX_VIA=rapidapi        # only if your key is from RapidAPI instead of API.market
# Alternative: FLIGHT_PROVIDER=aviationstack + AVIATIONSTACK_KEY (needs a PAID plan: free tier is HTTP-only, 100 req/month)
AVIATIONSTACK_KEY=

# Optional: signs /v1/status attestations (any Algorand account; no funds needed)
ATTESTOR_MNEMONIC=

# Optional: treasury that pays claims in USDC. Leave PAYOUTS_ENABLED=false until you have reviewed the legal side.
PAYOUTS_ENABLED=false
TREASURY_MNEMONIC=
ALGOD_URL=https://mainnet-api.algonode.cloud

DATA_DIR=./data
